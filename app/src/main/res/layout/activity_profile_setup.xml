<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/vowera_main_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_back"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Step 1 of 4"
                android:textColor="@color/rose_light"
                android:textSize="12sp"
                android:layout_marginEnd="24dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Your Profile"
            android:textColor="@color/rose_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Tell us a little about your wedding"
            android:textColor="@color/rose_text"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Your Name"
                android:textColor="@color/rose_title"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/yourNameInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/input_bg"
                android:hint="e.g. Ayesha"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#5F5050"
                android:textColorHint="#9B8585"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Partner's Name"
                android:textColor="@color/rose_title"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/partnerNameInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/input_bg"
                android:hint="e.g. Ahmed"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#5F5050"
                android:textColorHint="#9B8585"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Wedding Date"
                android:textColor="@color/rose_title"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/weddingDateInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/input_bg"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:hint="Tap to select date"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#5F5050"
                android:textColorHint="#9B8585"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="You Are"
                android:textColor="@color/rose_title"
                android:textSize="13sp"
                android:textStyle="bold" />

            <AutoCompleteTextView
                android:id="@+id/roleInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/input_bg"
                android:clickable="true"
                android:focusable="false"
                android:hint="Select role"
                android:inputType="none"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#5F5050"
                android:textColorHint="#9B8585"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Country"
                android:textColor="@color/rose_title"
                android:textSize="13sp"
                android:textStyle="bold" />

            <AutoCompleteTextView
                android:id="@+id/countryInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/input_bg"
                android:clickable="true"
                android:focusable="false"
                android:hint="Select country"
                android:inputType="none"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#5F5050"
                android:textColorHint="#9B8585"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="City"
                android:textColor="@color/rose_title"
                android:textSize="13sp"
                android:textStyle="bold" />

            <AutoCompleteTextView
                android:id="@+id/cityInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/input_bg"
                android:clickable="true"
                android:enabled="false"
                android:focusable="false"
                android:hint="Select city"
                android:inputType="none"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#5F5050"
                android:textColorHint="#9B8585"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Expected Number of Events"
                android:textColor="@color/rose_title"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/eventsInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="22dp"
                android:background="@drawable/input_bg"
                android:hint="e.g. 5"
                android:inputType="number"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#5F5050"
                android:textColorHint="#9B8585"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnProfileContinue"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="@color/rose_dark"
                android:text="CONTINUE"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>