<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/vowera_main_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_back"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Step 4 of 4"
                android:textColor="@color/rose_light"
                android:textSize="12sp"
                android:layout_marginEnd="24dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="serif"
            android:text="Your Budget"
            android:textColor="@color/rose_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Set how much you'd like to spend"
            android:textColor="@color/rose_text"
            android:textSize="13sp"
            android:layout_marginBottom="28dp" />

        <!-- Country -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Country"
            android:textColor="@color/rose_title"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <AutoCompleteTextView
            android:id="@+id/countryBudgetInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/input_bg"
            android:hint="Select country"
            android:textColor="#5F5050"
            android:textColorHint="#9B8585"
            android:textSize="15sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="16dp"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none" />

        <!-- Currency -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Currency"
            android:textColor="@color/rose_title"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <AutoCompleteTextView
            android:id="@+id/currencyInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/input_bg"
            android:hint="Select currency"
            android:textColor="#5F5050"
            android:textColorHint="#9B8585"
            android:textSize="15sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="24dp"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none"
            android:enabled="false" />

        <!-- Total Budget -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Wedding Budget"
            android:textColor="@color/rose_title"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/totalBudgetInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/input_bg"
            android:hint="e.g. 500000"
            android:textColor="#5F5050"
            android:textColorHint="#9B8585"
            android:textSize="16sp"
            android:inputType="numberDecimal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Optional: Allocate by category"
            android:textColor="@color/rose_title"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/budgetVenue"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/input_bg"
            android:hint="Venue"
            android:textColor="#5F5050"
            android:textColorHint="#9B8585"
            android:textSize="14sp"
            android:inputType="numberDecimal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/budgetDecor"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/input_bg"
            android:hint="Décor"
            android:textColor="#5F5050"
            android:textColorHint="#9B8585"
            android:textSize="14sp"
            android:inputType="numberDecimal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/budgetOutfits"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/input_bg"
            android:hint="Outfits"
            android:textColor="#5F5050"
            android:textColorHint="#9B8585"
            android:textSize="14sp"
            android:inputType="numberDecimal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/budgetFood"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/input_bg"
            android:hint="Food &amp; Catering"
            android:textColor="#5F5050"
            android:textColorHint="#9B8585"
            android:textSize="14sp"
            android:inputType="numberDecimal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/budgetPhotography"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/input_bg"
            android:hint="Photography &amp; Video"
            android:textColor="#5F5050"
            android:textColorHint="#9B8585"
            android:textSize="14sp"
            android:inputType="numberDecimal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/budgetMakeup"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/input_bg"
            android:hint="Makeup &amp; Hair"
            android:textColor="#5F5050"
            android:textColorHint="#9B8585"
            android:textSize="14sp"
            android:inputType="numberDecimal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/budgetTransport"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/input_bg"
            android:hint="Transport"
            android:textColor="#5F5050"
            android:textColorHint="#9B8585"
            android:textSize="14sp"
            android:inputType="numberDecimal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/budgetMisc"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/input_bg"
            android:hint="Miscellaneous"
            android:textColor="#5F5050"
            android:textColorHint="#9B8585"
            android:textSize="14sp"
            android:inputType="numberDecimal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnBudgetContinue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="@color/rose_dark"
            android:text="FINISH SETUP"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>