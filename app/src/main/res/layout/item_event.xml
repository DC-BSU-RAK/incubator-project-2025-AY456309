<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/input_bg"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvEventName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Event Name"
            android:textColor="@color/rose_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnEdit"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/social_icon_bg"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:padding="6dp"
            android:src="@drawable/ic_edit"
            app:tint="@color/rose_dark" />

        <ImageView
            android:id="@+id/btnDelete"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/social_icon_bg"
            android:padding="6dp"
            android:src="@drawable/ic_delete"
            app:tint="@color/rose_dark" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvEventDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Date: Not set"
        android:textColor="@color/rose_text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvEventLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Location: Not set"
        android:textColor="@color/rose_text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvEventBudget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Budget: 0"
        android:textColor="@color/rose_text"
        android:textSize="14sp" />

</LinearLayout>
