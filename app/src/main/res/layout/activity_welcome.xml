<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/vowera_main_bg">

    <LinearLayout
        android:id="@+id/welcomeContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingEnd="36dp">

        <ImageView
            android:id="@+id/welcomeLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/vowera_logo"
            android:contentDescription="Vowera logo"
            android:scaleType="fitCenter"
            android:layout_marginBottom="36dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="Welcome to Vowera"
            android:textColor="@color/rose_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Let's plan your wedding with clarity,\nelegance, and ease."
            android:textColor="@color/rose_text"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="48dp" />

        <Button
            android:id="@+id/btnStartPlanning"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="@color/rose_dark"
            android:text="START PLANNING"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</RelativeLayout>
