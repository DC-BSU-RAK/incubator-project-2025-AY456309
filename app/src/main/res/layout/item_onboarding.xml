<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top|center_horizontal"
    android:background="@android:color/transparent"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="36dp"
    android:paddingBottom="20dp">

    <ImageView
        android:id="@+id/imageOnboarding"
        android:layout_width="220dp"
        android:layout_height="190dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="80dp"
        android:background="@android:color/transparent"
        android:contentDescription="Onboarding image"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/textTitle"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Welcome to Vowera"
        android:textAlignment="center"
        android:textColor="@color/rose_title"
        android:textSize="23sp"
        android:textStyle="bold"
        android:fontFamily="serif" />

    <TextView
        android:id="@+id/textDescription"
        android:layout_width="270dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Wedding planning made beautiful and organized."
        android:textAlignment="center"
        android:textColor="@color/rose_text"
        android:textSize="16sp"
        android:lineSpacingExtra="3dp" />

</LinearLayout>