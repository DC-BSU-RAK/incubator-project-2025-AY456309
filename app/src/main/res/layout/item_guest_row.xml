<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@drawable/input_bg"
    android:layout_marginBottom="10dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <TextView
        android:id="@+id/guestName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@id/guestRsvp"
        android:layout_marginTop="12dp"
        android:textColor="@color/rose_title"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/guestSide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/guestName"
        android:layout_alignParentStart="true"
        android:textColor="@color/rose_text"
        android:textSize="12sp"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/guestPhone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/guestSide"
        android:layout_alignParentStart="true"
        android:textColor="@color/rose_light"
        android:textSize="11sp"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/guestRsvp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="@android:color/white"
        android:textSize="11sp"
        android:textStyle="bold" />

</RelativeLayout>